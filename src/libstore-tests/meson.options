# vim: filetype=meson

option(
  'benchmarks',
  type : 'boolean',
  value : false,
  description : 'Build benchmarks (requires gbenchmark)',
  yield : true,
)

option(
  'fuzzers',
  type : 'boolean',
  value : false,
  description : 'Build fuzz targets',
  yield : true,
)

option(
  'fuzzing-engine',
  type : 'string',
  value : '',
  description : 'One compiler-driver argument for linking an external fuzzing engine',
  yield : true,
)
