# vim: filetype=meson

option(
  'git-program',
  type : 'string',
  value : 'git',
  description : 'the git program used for fetching, ls-remote and signature verification (a name resolved via PATH, or an absolute path)',
)

option(
  'hg-program',
  type : 'string',
  value : 'hg',
  description : 'the Mercurial program used for fetching hg inputs (a name resolved via PATH, or an absolute path)',
)
