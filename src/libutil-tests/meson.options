# vim: filetype=meson

option(
  'unit-tests',
  type : 'boolean',
  value : true,
  description : 'Build unit tests',
  yield : true,
)

option(
  'fuzzers',
  type : 'boolean',
  value : false,
  description : 'Build fuzz targets',
  yield : true,
)

option(
  'fuzzing-engine',
  type : 'string',
  value : '',
  description : 'One compiler-driver argument for linking an external fuzzing engine',
  yield : true,
)
